{
  "name": "mindinbox-final",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:env-gate": "node scripts/test-check-env.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:ui:quick": "tsx scripts/audit/crawl.ts --no-interact --shots=viewport",
    "check:edge": "node scripts/check-edge.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:env:preview": "node scripts/check-env.mjs --env=preview",
    "check:env:local": "node scripts/check-env.mjs --env=local",
    "check:contrast": "node scripts/verify-contrast.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:mojibake": "node scripts/check-mojibake.mjs",
    "images:process": "node scripts/process-images.mjs",
    "art:build": "node scripts/build-art.mjs",
    "audit:ui": "tsx scripts/audit/crawl.ts",
    "og:make": "node scripts/make-og.mjs",
    "emulators": "firebase emulators:start --project mind-in-a-box-rules-test",
    "test:rules": "firebase emulators:exec --project mind-in-a-box-rules-test --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:rules:storage": "firebase emulators:exec --project mind-in-a-box-rules-test --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "start": "next start",
    "pages:build": "npx @cloudflare/next-on-pages@1",
    "pages:deploy": "npm run pages:build && npx wrangler pages deploy .vercel/output/static",
    "check:keys": "node scripts/check-no-keys.mjs",
    "check:no-riddle-leak": "node scripts/check-no-riddle-leak.mjs",
    "build:cf": "npm run check:edge && npm run check:contrast && npm run check:content && npm run check:mojibake && npm run check:keys && npm run typecheck && npm run lint && npm run test && npm run test:env-gate && npm run pages:build && npm run check:no-riddle-leak && npm run check:env"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^10.14.1",
    "framer-motion": "^11.18.2",
    "jose": "^6.2.12",
    "lucide-react": "^0.395.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.6.5",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.51.1",
    "@types/node": "^20",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "^10.4.19",
    "axe-core": "^4.13.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "firebase-tools": "^13.35.1",
    "postcss": "^8.4.38",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^2.0.5",
    "wrangler": "^3.114.17"
  }
}
