# ─────────────────────────────────────────────────────────────
# Copy to `.env.local` for local development.
# NEVER commit real values. `.env.local` is gitignored.
#
# On Cloudflare Pages, set the non-NEXT_PUBLIC entries as *secrets*
# (Dashboard → Settings → Environment variables), not plain variables.
# ─────────────────────────────────────────────────────────────

# ── Firebase (public config; safe to expose to the browser) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── AI providers (SECRETS — server/edge only, never NEXT_PUBLIC_) ──
# At least one is required. The edge route rotates through them in order
# and reports which one answered.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
BYTEZ_API_KEY=

# Optional endpoint override per provider. Use for a self-hosted or proxied
# provider. Anthropic and Gemini accept https only, so production cannot be
# pointed at a plaintext endpoint by accident.
#
# The e2e suite uses these to reach scripts/fake-upstream.mjs, because
# Playwright cannot intercept a server-side fetch and faking /api/ai from the
# test would replace the very gateway the tests are about.
# AI_BASE_URL_ANTHROPIC=
# AI_BASE_URL_GEMINI=
# AI_BASE_URL_GROQ=
# AI_BASE_URL_NVIDIA=

# Optional per-provider model overrides.
# Defaults were resolved against each provider's live catalogue on 2026-10.
# Model ids churn — if a provider starts returning 404/400, re-check its
# catalogue and pin a current id here.
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
BYTEZ_MODEL=llama3.1-70b

# Bytez has no stable OpenAI-compatible host; override if yours differs.
# BYTEZ_BASE_URL=https://api.gpt.ge/v1

# ── Per-IP quota salt (SECRET) ──
# DAILY SALT for the per-IP usage ceiling: the raw address is hashed with it and
# never stored. Rotating this resets the per-IP counters, which is the intended
# way to clear them.
#
# It does NOT sign the anonymous session cookie any more — that scheme was
# superseded (PROJECT_MAP D30). The allowance is metered server-side against the
# `miab-anon` cookie the route issues itself.
#
# If this is shorter than 32 characters the per-IP ceiling is silently skipped
# and only the per-key allowance applies.
# Generate:  openssl rand -base64 48
ANON_SESSION_SECRET=
# --- Cloudflare Turnstile (signup gate) ---
# The SECRET key is server-only: set it as a Cloudflare *Secret*
# (Dashboard > Settings > Environment variables > Secret). The site key is
# public by design.
# Create the widget at dash.cloudflare.com > Turnstile > Add widget.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Firebase service account (SECRET, admin only) ---
# JSON of the service-account key. Used by src/lib/google/token.ts to mint
# access tokens for privileged Firestore writes (subscriptions, usage, grants,
# metrics, and the account-deletion cascade).
# Required scope: firebaseauth.users.delete + cloud-platform (or a narrower
# datastore scope). NEVER commit this. NEVER prefix it with NEXT_PUBLIC_.
# Create: firebase projects:service-accounts:create
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Canonical origin, used for canonical URLs and sitemap.xml ---
NEXT_PUBLIC_SITE_URL=https://mindinbox-final.pages.dev
