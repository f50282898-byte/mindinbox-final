# ─────────────────────────────────────────────────────────────
# Copy to `.env.local` for local development.
# NEVER commit real values. `.env.local` is gitignored.
#
# On Cloudflare Pages, set the non-NEXT_PUBLIC entries as *secrets*
# (Dashboard → Settings → Environment variables), not plain variables.
# ─────────────────────────────────────────────────────────────

# ── Firebase (public config; safe to expose to the browser) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── AI providers (SECRETS — server/edge only, never NEXT_PUBLIC_) ──
# At least one is required. The edge route rotates through them in order
# and reports which one answered.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
BYTEZ_API_KEY=

# Optional per-provider model overrides.
# Defaults were resolved against each provider's live catalogue on 2026-10.
# Model ids churn — if a provider starts returning 404/400, re-check its
# catalogue and pin a current id here.
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
BYTEZ_MODEL=llama3.1-70b

# Bytez has no stable OpenAI-compatible host; override if yours differs.
# BYTEZ_BASE_URL=https://api.gpt.ge/v1

# ── Anonymous usage signing (SECRET) ──
# Stable random string, >= 32 chars. Signs the anonymous session cookie that
# enforces the 5 free AI attempts server-side.
# Generate:  openssl rand -base64 48
ANON_SESSION_SECRET=

# ── Admin console (SECRET) ──
# Service-account JSON used by the edge admin route to mint/verify privileged
# claims. Single-line JSON. Requires firestore + iam + custom-claim scope.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Legacy local-only fallback UID (development convenience only;
# production authorisation comes from the `admin: true` custom claim).
ADMIN_UID=