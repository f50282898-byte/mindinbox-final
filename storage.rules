rules_version = '2';

/**
 * Cloud Storage security rules.
 *
 * Principle: DENY BY DEFAULT, as in firestore.rules. Every path must be matched
 * explicitly; there is no catch-all.
 *
 * Paths:
 *   users/{uid}/...          a user's own uploads, private
 *   premium-library/{file}   study PDFs, gated on entitlements
 *
 * Storage rules cannot call `getEntitlements` — they evaluate Firestore with
 * `firestore.get()`, so the tier is read from `subscriptions/{uid}` directly.
 * The two must stay consistent: Firestore holds the authoritative record.
 *
 */
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }


    // Match server entitlements: trials do not confer a premium tier.
    function unexpired(data, field) {
      return !(field in data) || data[field] == null
        || (data[field] is timestamp && data[field] > request.time)
        || (data[field] is int && data[field] > request.time.toMillis());
    }
    function hasSubscription() {
      let path = /databases/(default)/documents/subscriptions/$(request.auth.uid);
      return firestore.exists(path)
        && firestore.get(path).data.status == 'active'
        && firestore.get(path).data.tier in ['oracle', 'sanctum']
        && unexpired(firestore.get(path).data, 'currentPeriodEnd');
    }
    function hasGrant() {
      let path = /databases/(default)/documents/grants/$(request.auth.uid);
      return firestore.exists(path)
        && firestore.get(path).data.tier in ['oracle', 'sanctum']
        && unexpired(firestore.get(path).data, 'expiresAt');
    }
    function hasOracle() { return signedIn() && (hasSubscription() || hasGrant()); }

    /* ── per-user uploads ──────────────────────────────────────────────────
       Private by default: only the owner reads. Kept small and type-limited
       because user uploads are the one place an attacker could land arbitrary
       content and have it served from our own bucket.
       -------------------------------------------------------------------- */
    match /users/{uid}/{allPaths=**} {
      allow read: if isSelf(uid);
      allow delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('^(image/(jpeg|png|webp)|application/pdf)$');
    }

    /* ── premium study library ─────────────────────────────────────────── */
    match /premium-library/{fileName} {
      // At most two Firestore documents per Storage request.
      // Administrative file operations use the server IAM identity, not a client bypass.
      allow read: if hasOracle();

      // Uploads are server-only, same as the Firestore records they mirror.
      allow write: if false;
    }

    /* ── everything else is denied ─────────────────────────────────────── */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
