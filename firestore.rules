rules_version = '2';

/**
 * Firestore security rules — data model v1.
 *
 * Principle: DENY BY DEFAULT. Nothing is readable or writable unless a rule
 * below says so explicitly. There is no catch-all `allow` anywhere.
 *
 * Collections (v1):
 *   users/{uid}               profile
 *   users/{uid}/days/{date}   one document per calendar day
 *   subscriptions/{uid}       billing record       — SERVER ONLY
 *   usage/{uid}               metering counters     — SERVER ONLY
 *   grants/{id}               comps / promotions    — SERVER ONLY
 *   admins/{uid}              admin roster          — SERVER READ for members
 *   siteConfig/{doc}          editable copy         — public read, admin write
 *   metrics/{day}             daily aggregates      — SERVER ONLY
 *
 * Legacy collections kept so existing data does not become unreachable:
 *   users/{uid}/entries, users/{uid}/events, users/{uid}/puzzles
 *   analyticsEvents, analyticsSessions, communityPosts
 *
 * Admin identity is "the document `admins/{uid}` exists", not a custom claim.
 * A claim is minted when the token is issued and stays valid for up to an hour
 * after the document is deleted, so a claim cannot express revocation. Reading
 * the document on each privileged request makes revocation immediate.
 *
 * `serviceAccount` matches the Admin SDK / REST path. Note it is a *token
 * identity*, not an IP: anyone holding the service-account token is the server,
 * which is why that token must live only in a Cloudflare secret.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ── helpers ───────────────────────────────────────────────────────── */

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isService() {
      return request.auth != null && request.auth.token.email == 'firebase-adminsdk@system.gserviceaccount.com';
    }

    // Server writes are trusted. Client writes never take this path.
    function serverOnly() {
      return isService() || isAdmin();
    }

    function isValidDateKey(date) {
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    /* ── users/{uid} ────────────────────────────────────────────────────── */

    match /users/{uid} {

      // A user reads only their own profile. Admins read it too, but the
      // privacy policy states admins see aggregates, not journal text; this
      // read exists for support and is a known gap, called out in /privacy.
      allow get, list: if isSelf(uid) || isAdmin();

      // Signup. The key set is closed and `createdAt` must be server time, so a
      // client cannot pre-write a membership tier or backdate an account.
      // `trialEnd` is a free-trial window only; it grants no access by itself.
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
             'email', 'displayName', 'locale', 'theme', 'createdAt', 'trialEnd'
           ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.trialEnd is timestamp
        && request.resource.data.trialEnd >= request.time
        && request.resource.data.trialEnd <= request.time + duration.value(14, 'd');

      // A user may change presentation only. Tier, trialEnd and createdAt are
      // not in the allowed set, so they can never be self-edited.
      allow update: if isAdmin() || (
        isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['email', 'displayName', 'locale', 'theme'])
      );

      // Deletion goes through the server endpoint, which cascades subcollections
      // first. A client cannot orphan subcollections by deleting the parent.
      allow delete: if false;

      /* ── users/{uid}/days/{date} ─────────────────────────────────────── */

      match /days/{date} {
        allow read: if isSelf(uid) || isAdmin();
        allow delete: if isSelf(uid) || isAdmin();

        // Closed key set, bounded strings, server-stamped date. `date` is
        // checked against the document id, so a client cannot file today under
        // yesterday to reset a streak.
        allow create, update: if isSelf(uid)
          && isValidDateKey(date)
          && date == request.time.substr(0, 10)
          && request.resource.data.keys().hasOnly([
               'date', 'mood', 'note', 'habits', 'updatedAt', 'createdAt'
             ])
          && request.resource.data.date == date
          && request.resource.data.mood is int
          && request.resource.data.mood >= 1
          && request.resource.data.mood <= 5
          && (!('note' in request.resource.data)
              || (request.resource.data.note is string
                  && request.resource.data.note.size() <= 2000))
          && (!('habits' in request.resource.data) || request.resource.data.habits is list)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
      }

      /* ── legacy user subcollections ───────────────────────────────────── */

      match /entries/{entryId} {
        allow read, delete: if isSelf(uid) || isAdmin();
        allow create, update: if (isSelf(uid) || isAdmin())
          && request.resource.data.keys().hasOnly(['kind', 'text', 'createdAt'])
          && request.resource.data.kind in ['habit', 'thought', 'time']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt is timestamp;
      }

      match /events/{eventId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['type', 'createdAt'])
          && request.resource.data.type == 'ai_interaction';
        allow update, delete: if false;
      }

      match /puzzles/{puzzleId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }
    }

    /* ── subscriptions — SERVER ONLY ───────────────────────────────────────
       Billing state. A client that could write this could grant itself the
       top tier, so reads and writes are both denied to clients outright.
       -------------------------------------------------------------------- */
    match /subscriptions/{uid} {
      allow read, write: if false;
    }

    /* ── usage — SERVER ONLY ───────────────────────────────────────────────
       Metering counters. A client that could decrement these could reset its
       own quota; one that could increment them could exhaust them for others.
       -------------------------------------------------------------------- */
    match /usage/{uid} {
      allow read, write: if false;
    }

    /* ── grants — SERVER ONLY ──────────────────────────────────────────── */
    match /grants/{grantId} {
      allow read, write: if false;
    }

    /* ── metrics — SERVER ONLY ─────────────────────────────────────────── */
    match /metrics/{day} {
      allow read, write: if false;
    }

    /* ── admins ──────────────────────────────────────────────────────────
       Readable by any signed-in user so the client can decide whether to render
       the console. A user can read their OWN row (harmless, and it is the
       only way "am I an admin" is answerable client-side). Writes are denied to
       every client: promoting an admin is a server-only operation.
       -------------------------------------------------------------------- */
    match /admins/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    /* ── siteConfig ──────────────────────────────────────────────────────
       Public read for the copy the whole site needs. Writes are server-only.
       -------------------------------------------------------------------- */
    match /siteConfig/{doc} {
      allow read: if true;
      allow write: if false;
    }

    /* ── analytics (legacy, client-collected) ──────────────────────────── */

    match /analyticsEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'type', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['signup', 'ai_interaction'];
      allow update, delete: if false;
    }

    match /analyticsSessions/{sessionId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'durationSeconds', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds >= 0;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds >= resource.data.durationSeconds;
      allow delete: if isAdmin();
    }

    match /communityPosts/{postId} {
      allow read, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'authorName', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1200
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }
  }
}
