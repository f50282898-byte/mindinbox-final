rules_version = '2';

/**
 * Firestore security rules — data model v1.
 *
 * Principle: DENY BY DEFAULT. Nothing is readable or writable unless a rule
 * below says so explicitly. There is no catch-all `allow` anywhere.
 *
 * Collections (v1):
 *   users/{uid}                    profile          - self + admin read (see note)
 *   users/{uid}/days/{date}        the journal      - SELF ONLY, never admin
 *   users/{uid}/habits/{habitId}   habit definitions- SELF ONLY
 *   users/{uid}/principles         stated values    - SELF ONLY
 *   users/{uid}/settings           zone + consent   - SELF ONLY
 *   subscriptions/{uid}            billing record   - SERVER ONLY
 *   usage/{uid}                    metering counters- SERVER ONLY
 *   grants/{id}                    comps / promotions- SERVER ONLY
 *   admins/{uid}                   admin roster     - self-read only
 *   siteConfig/{doc}               editable copy    - public read, admin write
 *   metrics/{day}                  daily aggregates - SERVER ONLY
 *
 * The journal collections (days/habits/principles/settings) are deliberately the
 * strictest in this file: **no `isAdmin()` anywhere in them.** A journal is the
 * most sensitive thing the product holds, and the standing rule is that an admin
 * sees aggregates and never content. The legacy collections below still grant
 * admins a read, which is a known gap admitted in /privacy; the new ones do not
 * extend it.
 *
 * Legacy collections kept so existing data does not become unreachable:
 *   users/{uid}/entries, users/{uid}/events, users/{uid}/puzzles
 *   analyticsEvents, analyticsSessions, communityPosts
 *
 * Admin identity is "the document `admins/{uid}` exists", not a custom claim.
 * A claim is minted when the token is issued and stays valid for up to an hour
 * after the document is deleted, so a claim cannot express revocation. Reading
 * the document on each privileged request makes revocation immediate.
 *
 * `serviceAccount` matches the Admin SDK / REST path. Note it is a *token
 * identity*, not an IP: anyone holding the service-account token is the server,
 * which is why that token must live only in a Cloudflare secret.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ── helpers ───────────────────────────────────────────────────────── */

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isService() {
      return request.auth != null && request.auth.token.email == 'firebase-adminsdk@system.gserviceaccount.com';
    }

    // Server writes are trusted. Client writes never take this path.
    function serverOnly() {
      return isService() || isAdmin();
    }

    function isValidDateKey(date) {
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    /* ── users/{uid} ────────────────────────────────────────────────────── */

    match /users/{uid} {

      // A user reads only their own profile. Admins read it too, but the
      // privacy policy states admins see aggregates, not journal text; this
      // read exists for support and is a known gap, called out in /privacy.
      allow get, list: if isSelf(uid) || isAdmin();

      // Signup. The key set is closed and `createdAt` must be server time, so a
      // client cannot pre-write a membership tier or backdate an account.
      // `trialEnd` is a free-trial window only; it grants no access by itself.
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
             'email', 'displayName', 'locale', 'theme', 'createdAt', 'trialEnd'
           ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.trialEnd is timestamp
        && request.resource.data.trialEnd >= request.time
        && request.resource.data.trialEnd <= request.time + duration.value(14, 'd');

      // A user may change presentation only. Tier, trialEnd and createdAt are
      // not in the allowed set, so they can never be self-edited.
      allow update: if isAdmin() || (
        isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['email', 'displayName', 'locale', 'theme'])
      );

      // Deletion goes through the server endpoint, which cascades subcollections
      // first. A client cannot orphan subcollections by deleting the parent.
      allow delete: if false;

      /* ── users/{uid}/days/{date} — the journal (prompt 08) ─────────────── */

      match /days/{date} {
        // Own days only. NOT isAdmin(): a journal is the most sensitive thing in
        // the product, and the standing rule is that an admin sees aggregates and
        // never content. Letting an admin read this would quietly break that rule
        // for the one collection where it matters most.
        allow read: if isSelf(uid);
        allow delete: if isSelf(uid);

        /*
         * The day key is the reader's LOCAL calendar date, so it is deliberately
         * not compared against `request.time` (which is UTC). Forcing them equal
         * would file every entry of a reader east of Greenwich under yesterday.
         *
         * Instead the key is checked for shape, and bounded against now: a reader
         * may write today or a past day, never a future one, and never absurdly far
         * back. A future-dated key would let someone pre-fill a streak.
         */
        function isPlausibleDayKey(key) {
          return key.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && key <= request.time.substr(0, 10)
            && key >= request.time.substr(0, 8) + '01';   // not before the current month
        }

        /*
         * `updatedAt` is the CLIENT's clock, because the journal is written
         * offline and must not wait for a server round-trip. That is a real trust
         * trade, so it is bounded rather than trusted: within a day either side of
         * now. A client cannot backdate to win a merge against another device, nor
         * set a far-future stamp to make its edit look permanently newer.
         */
        function isClientTimestamp(ts) {
          return ts is int && ts >= request.time - 86400000 && ts <= request.time + 86400000;
        }

        function isRating(v) {
          return v is int && v >= 1 && v <= 5;
        }

        function isRatingMap(v) {
          return v is map
            && v.keys().hasOnly(['energy', 'focus', 'mood'])
            && (!('energy' in v) || isRating(v.energy))
            && (!('focus'  in v) || isRating(v.focus))
            && (!('mood'   in v) || isRating(v.mood));
        }

        allow create, update: if isSelf(uid)
          && isPlausibleDayKey(date)
          && request.resource.data.keys().hasOnly([
               'date', 'timeZone', 'habits', 'checkIn', 'practice',
               'virtues', 'journal', 'updatedAt', 'lastWriter'
             ])
          && request.resource.data.date == date
          && request.resource.data.timeZone is string
          && request.resource.data.timeZone.size() <= 64
          && isClientTimestamp(request.resource.data.updatedAt)
          && (!('checkIn' in request.resource.data)
              || (request.resource.data.checkIn is map
                  && request.resource.data.checkIn.keys().hasOnly(['energy', 'focus', 'mood', 'tags'])
                  && (!('energy' in request.resource.data.checkIn)
                      || isRating(request.resource.data.checkIn.energy))
                  && (!('focus' in request.resource.data.checkIn)
                      || isRating(request.resource.data.checkIn.focus))
                  && (!('mood' in request.resource.data.checkIn)
                      || isRating(request.resource.data.checkIn.mood))
                  && (!('tags' in request.resource.data.checkIn)
                      || (request.resource.data.checkIn.tags is list
                          && request.resource.data.checkIn.tags.size() <= 12))))
          && (!('virtues' in request.resource.data)
              || (request.resource.data.virtues is map
                  && request.resource.data.virtues.keys()
                       .hasOnly(['wisdom', 'courage', 'temperance', 'justice'])
                  && request.resource.data.virtues.values().all(isRating)))
          && (!('practice' in request.resource.data)
              || (request.resource.data.practice is map
                  && request.resource.data.practice.keys().hasOnly(['read', 'applied', 'reflected', 'note'])
                  && (!('read' in request.resource.data.practice)
                      || request.resource.data.practice.read is bool)
                  && (!('applied' in request.resource.data.practice)
                      || request.resource.data.practice.applied is bool)
                  && (!('reflected' in request.resource.data.practice)
                      || request.resource.data.practice.reflected is bool)
                  && (!('note' in request.resource.data.practice)
                      || (request.resource.data.practice.note is string
                          && request.resource.data.practice.note.size() <= 2000))))
          && (!('journal' in request.resource.data)
              || (request.resource.data.journal is list
                  && request.resource.data.journal.size() <= 40
                  && request.resource.data.journal.all(b,
                      b is map
                      && b.keys().hasOnly(['template', 'text', 'prompt', 'updatedAt'])
                      && b.template in ['morning', 'evening', 'question', 'free']
                      && b.text is string
                      && b.text.size() <= 8000
                      && (!('prompt' in b) || (b.prompt is string && b.prompt.size() <= 2000))
                      && isClientTimestamp(b.updatedAt))))
          && (!('habits' in request.resource.data)
              || (request.resource.data.habits is map
                  && request.resource.data.habits.size() <= 20
                  && request.resource.data.habits.keys().all(k, k.size() <= 64)
                  && request.resource.data.habits.values().all(t,
                      t is map
                      && t.keys().hasOnly(['done', 'note', 'updatedAt'])
                      && t.done is bool
                      && (!('note' in t) || (t.note is string && t.note.size() <= 2000))
                      && isClientTimestamp(t.updatedAt))))
          && (!('lastWriter' in request.resource.data)
              || (request.resource.data.lastWriter is string
                  && request.resource.data.lastWriter.size() <= 64));
      }

      /* ── users/{uid}/habits/{habitId} ──────────────────────────────────── */

      match /habits/{habitId} {
        allow read, delete: if isSelf(uid);

        allow create, update: if isSelf(uid)
          && habitId.size() <= 64
          && request.resource.data.keys().hasOnly([
               'id', 'title', 'intention', 'weekdays', 'everyNDays',
               'grace', 'archived', 'category', 'createdAt', 'updatedAt', 'order'
             ])
          && request.resource.data.id == habitId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && (!('intention' in request.resource.data)
              || (request.resource.data.intention is string
                  && request.resource.data.intention.size() <= 500))
          // `grace` is capped at 3. One is the design; a habit with an unlimited
          // grace has a streak that cannot be lost, which is not a streak.
          && request.resource.data.grace is int
          && request.resource.data.grace >= 0
          && request.resource.data.grace <= 3
          && request.resource.data.weekdays is list
          && request.resource.data.weekdays.size() <= 7
          && request.resource.data.weekdays.all(d, d is int && d >= 0 && d <= 6)
          && request.resource.data.archived is bool
          && request.resource.data.order is int
          && request.resource.data.order >= 0
          && request.resource.data.order <= 1000;
      }

      /* ── users/{uid}/principles — the reader's own stated values ───────── */

      match /principles {
        allow read: if isSelf(uid);

        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['items'])
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 50
          && request.resource.data.items.all(p,
              p is map
              && p.keys().hasOnly(['id', 'text', 'createdAt'])
              && p.id is string
              && p.id.size() <= 64
              && p.text is string
              && p.text.size() > 0
              && p.text.size() <= 500
              && p.createdAt is int);
      }

      /* ── users/{uid}/settings ──────────────────────────────────────────── */

      match /settings {
        allow read: if isSelf(uid);

        /*
         * The reader writes their own timezone and their own consent flag — both are
         * genuinely theirs, and refusing them would make the app unusable.
         *
         * Note there is no server-written field here. `getEntitlements` derives the
         * tier from `subscriptions`, so there is nothing in this document a client
         * could set to gain access. `aiJournalConsent` only ever *restricts* what
         * the server may read, so a client that sets it to `true` grants itself
         * nothing it did not already have.
         */
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly([
               'timeZone', 'aiJournalConsent', 'habitsLimit', 'historyDaysLimit'
             ])
          && request.resource.data.timeZone is string
          && request.resource.data.timeZone.size() <= 64
          && request.resource.data.aiJournalConsent is bool
          && (!('habitsLimit' in request.resource.data)
              || (request.resource.data.habitsLimit is int
                  && request.resource.data.habitsLimit >= 0
                  && request.resource.data.habitsLimit <= 1000))
          && (!('historyDaysLimit' in request.resource.data)
              || (request.resource.data.historyDaysLimit is int
                  && request.resource.data.historyDaysLimit >= 0
                  && request.resource.data.historyDaysLimit <= 100000));
      }

      /* ── legacy user subcollections ───────────────────────────────────── */

      match /entries/{entryId} {
        allow read, delete: if isSelf(uid) || isAdmin();
        allow create, update: if (isSelf(uid) || isAdmin())
          && request.resource.data.keys().hasOnly(['kind', 'text', 'createdAt'])
          && request.resource.data.kind in ['habit', 'thought', 'time']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt is timestamp;
      }

      match /events/{eventId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['type', 'createdAt'])
          && request.resource.data.type == 'ai_interaction';
        allow update, delete: if false;
      }

      match /puzzles/{puzzleId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }
    }

    /* ── subscriptions — SERVER ONLY ───────────────────────────────────────
       Billing state. A client that could write this could grant itself the
       top tier, so reads and writes are both denied to clients outright.
       -------------------------------------------------------------------- */
    match /subscriptions/{uid} {
      allow read, write: if false;
    }

    /* ── usage — SERVER ONLY ───────────────────────────────────────────────
       Metering counters. A client that could decrement these could reset its
       own quota; one that could increment them could exhaust them for others.
       -------------------------------------------------------------------- */
    match /usage/{uid} {
      allow read, write: if false;
    }

    /* ── grants — SERVER ONLY ─────────────────────────────────────────────
       The prize a riddle pays. Written only by `/api/riddle/answer`, readable by
       nobody from a client — `getEntitlements` reads it server-side, so a client
       that could read it would learn another reader's tier by guessing ids.
       -------------------------------------------------------------------- */
    match /grants/{grantId} {
      allow read, write: if false;
    }

    /* ── riddle — SERVER ONLY ────────────────────────────────────────────
       Every collection here is state the server alone may touch:

         players/{uid}  cooldown, roll counters, attempts
         budget/{key}   global wins per UTC day and month
         tokens/{jti}   the single-use record that makes a win token non-replayable
         wins/{id}      the admin grant log
         ip/{bucket}    a *hash* of an address, never the address

       Denying client writes is not a formality here. If a reader could increment
       `budget`, they would decide their own odds; if they could write `players`,
       they could reset their own cooldown; if they could create `tokens`, they
       could mark a replayed token spent before replaying it. Each of those is the
       whole game, so there is no client-allowed path into this subtree at all.

       `ip` is called out because it is the one collection a future contributor
       might reasonably assume is safe: the document id is an HMAC, not an address,
       but the count is still state, and still not the reader's to change.
       -------------------------------------------------------------------- */
    match /riddle/{collectionName}/{docId} {
      allow read, write: if false;
    }

    /* ── auditLog — SERVER ONLY, and append-only ──────────────────────────
       Every admin write lands here with actor, action, target, before and after.

       Reads are denied to admins as well as to readers, deliberately. An audit
       trail that admins can edit is not an audit trail: the guarantee here is not
       "admins should behave" but "admins *cannot* remove the record". If a review
       surface is ever wanted, it must be built as a separate, append-only view
       rather than by opening this collection.

       `before` and `after` are why this is closed to clients. They hold the full
       document as it was — including any admin-authored copy — and Firestore rules
       cannot inspect a nested field's *absence*. A rule that tried to filter on
       "no reader text in this map" would be trivially bypassed by moving the same
       text one key deeper, so the honest control is that only the server writes it,
       and only the server can be trusted to keep reader content out of it.

       The privacy boundary that protects a reader is upstream: `recordWrite` has no
       way to be handed a reader's text, because the routes that call it pass site
       documents and uids, and the journal and chat documents are not readable by
       this process at all.
       -------------------------------------------------------------------- */
    match /auditLog/{entryId} {
      allow read, write: if false;
    }

    /* ── siteContent ───────────────────────────────────────────────────────
       `published` is public: the whole point is that the site reads it.

       `draft` and `history` are server-only. A client that could write the draft
       would be able to install arbitrary navigation and pricing copy and then ask
       for a publish — turning "an admin edits the site" into "anyone edits the
       site". Drafts are not sensitive enough to hide from readers, but they are
       not allowed to be *written* by anyone but the server, and read access is
       closed for the same reason: a draft shows unpublished copy, and an
       unannounced pricing change visible to a reader is a pricing change.
       -------------------------------------------------------------------- */
    match /siteContent/published {
      allow read: if true;
      allow write: if false;
    }
    match /siteContent/draft {
      allow read, write: if false;
    }
    match /siteContent/history/{versionId} {
      allow read, write: if false;
    }

    /* ── assistantProposals — SERVER ONLY ────────────────────────────────
       A proposal is a draft change that nobody has approved. If a client could
       write one, the assistant panel could be made to render arbitrary text into
       an admin's screen as though the model had proposed it — a convincing
       surface wearing the assistant's name.
       -------------------------------------------------------------------- */
    match /assistantProposals/{proposalId} {
      allow read, write: if false;
    }

    /* ── metrics — SERVER ONLY ─────────────────────────────────────────── */
    match /metrics/{day} {
      allow read, write: if false;
    }

    /* ── admins ──────────────────────────────────────────────────────────
       Readable by any signed-in user so the client can decide whether to render
       the console. A user can read their OWN row (harmless, and it is the
       only way "am I an admin" is answerable client-side). Writes are denied to
       every client: promoting an admin is a server-only operation.
       -------------------------------------------------------------------- */
    match /admins/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    /* ── siteConfig ──────────────────────────────────────────────────────
       Public read for the copy the whole site needs. Writes are server-only.
       -------------------------------------------------------------------- */
    match /siteConfig/{doc} {
      allow read: if true;
      allow write: if false;
    }

    /* ── analytics (legacy, client-collected) ──────────────────────────── */

    match /analyticsEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'type', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['signup', 'ai_interaction'];
      allow update, delete: if false;
    }

    match /analyticsSessions/{sessionId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'durationSeconds', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds >= 0;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds >= resource.data.durationSeconds;
      allow delete: if isAdmin();
    }

    match /communityPosts/{postId} {
      allow read, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'authorName', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1200
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }
  }
}
